# Cadena de conexion de PostgreSQL (Neon, Supabase, Railway, un servidor propio, etc.)
DATABASE_URL=postgres://usuario:password@host:5432/basededatos

# Cadena larga y aleatoria usada para firmar las sesiones (JWT).
# Genera una con: openssl rand -hex 32
JWT_SECRET=

# Email que se vuelve administrador automaticamente al registrarse.
ADMIN_EMAIL=admin@example.com

# Opcional, 3000 por defecto.
PORT=3000
